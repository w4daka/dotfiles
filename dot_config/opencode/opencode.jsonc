{
  "$schema": "https://opencode.ai/config.json",
  "permission" : {
    "bash": {
        "*": "ask",

        "git status*": "allow",
        "git diff*": "allow",
        "git log*": "allow",

        "rm -rf *": "deny",
        "git push --force*": "deny",
        "sudo *": "deny",
        "dd *": "deny",
        "mkfs*": "deny",
        "format*": "deny",
    },
      "edit" : "ask",
    "read": {
        "*": "allow",
        "*.env": "deny",
        "*.env.*": "deny",
       "*.env.example": "allow"
    },
      "grep" : "allow",
      "glob" : "allow",
      "lsp" :  "allow",
      "skill": "allow",
      "todowrite" : "allow",
      "webfetch" : "allow",
      "websearch" : "allow",
      "question" : "allow"
  },
  "lsp" : true,
  "default_agent": "plan",
}
